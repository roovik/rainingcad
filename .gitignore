npm/
node_modules/
*.pdf
*.png
*.jpg
*.html
__pycache__/

# built site is committed
!site/**/*.html
!site/**/*.png
!site/**/*.svg

# merch print files are large and generated
catyear_repo/merch/printify_cats/*.png
catyear_repo/merch/printify_cats/Mugs_15oz_2475x1275/

# everybitch built pages are committed so the Cloudflare deploy needs no build step
!site-everybitch/public/**/*.html
!site-everybitch/public/**/*.png
.wrangler/

# page images and quiz pictures are made from the book PDFs (tools/make_inside.py, tools/make_quizzes.py); the built copies in site/ are committed
tools/inside/*/pages/
tools/quiz/*/img/
